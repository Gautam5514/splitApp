# Copy to `.env` and fill in your own values. Never commit `.env`.

# Backend API. "localhost" does NOT work from a phone or Android emulator —
# use your computer's LAN IP (macOS: `ipconfig getifaddr en0`), or
# 10.0.2.2 for the Android emulator.
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:5000

# Firebase (Console → Project settings → Your apps → Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In OAuth client IDs (Google Cloud Console → Credentials).
# The Android client must match your package name + debug SHA-1.
# The Web client is required for Firebase-compatible ID tokens.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
