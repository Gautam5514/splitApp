{
  "expo": {
    "name": "SplitEase",
    "slug": "splitApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo.png",
    "scheme": "splitapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kunal.splitapp",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "SplitEase uses your photo library when you choose a profile photo, receipt, or chat attachment."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050912",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.kunal.splitapp",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "splitapp",
              "host": "auth"
            },
            {
              "scheme": "com.kunal.splitapp",
              "pathPrefix": "/oauthredirect"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "splitapp",
              "host": "auth"
            },
            {
              "scheme": "com.kunal.splitapp",
              "pathPrefix": "/oauthredirect"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.803396684704-t2m1r9sk8qqod63jkd1fhl8mr61qb1o0"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#4f46e5",
          "sounds": []
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SplitEaseBalance",
              "label": "SplitEase Balance",
              "description": "See what you owe and what others owe you, then tap to open SplitEase.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "googleRedirectUri": "https://auth.expo.io/@kunalkumar/splitApp",
      "googleWebClientId": "803396684704-3ilatdscisg178ouh81o0pere3s1v913.apps.googleusercontent.com",
      "googleAndroidClientId": "803396684704-ncu0hc5mpm28ftf0scvqpbpr2uglvtgd.apps.googleusercontent.com",
      "googleIosClientId": "803396684704-t2m1r9sk8qqod63jkd1fhl8mr61qb1o0.apps.googleusercontent.com",
      "googleExpoClientId": "803396684704-o4davigc3jvbf5i13dqj5djpss3946bn.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "a06f7201-44fc-4ef3-a7f2-efda413a7d1c"
      }
    }
  }
}
