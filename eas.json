{
    "cli": {
          "version": ">= 16.17.3",
          "appVersionSource": "remote"
    },
    "build": {
          "development": {
                  "developmentClient": true,
                  "distribution": "internal"
          },
          "preview": {
                  "distribution": "internal",
                  "android": {
                            "buildType": "apk"
                  }
          },
          "production": {
                  "autoIncrement": true,
                  "android": {
                            "buildType": "app-bundle"
                  }
          },
          "production-apk": {
                  "autoIncrement": true,
                  "distribution": "internal",
                  "android": {
                            "buildType": "apk"
                  }
          }
    },
    "submit": {
          "production": {
                  "android": {
                            "track": "production",
                            "releaseStatus": "completed"
                  }
          }
    }
}
